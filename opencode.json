{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "enabled": true
    },
		"exa": {
			"type": "remote",
			"url": "https://mcp.exa.ai/mcp",
			"headers": {
				"Authorization": "Bearer {env:EXA_API_KEY}"
			},
			"enabled": true
		}
	},
	"permission": {
		"read": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny"
		}
	}
}
